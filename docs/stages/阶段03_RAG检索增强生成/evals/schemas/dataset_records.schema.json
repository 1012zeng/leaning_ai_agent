{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leaning-ai-agent.example/schemas/rag-eval-dataset-1.0.0.json",
  "title": "RAG evaluation dataset records",
  "oneOf": [
    {"$ref": "#/$defs/source_document"},
    {"$ref": "#/$defs/chunk"},
    {"$ref": "#/$defs/eval_case"},
    {"$ref": "#/$defs/ground_truth"},
    {"$ref": "#/$defs/retrieval_label"},
    {"$ref": "#/$defs/manifest"}
  ],
  "$defs": {
    "semver": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "prefixed_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "profile_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_id", "profile_version", "config_hash"],
      "properties": {
        "profile_id": {"type": "string", "minLength": 1},
        "profile_version": {"$ref": "#/$defs/semver"},
        "config_hash": {"$ref": "#/$defs/prefixed_sha256"}
      }
    },
    "span": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": {"type": "integer", "minimum": 0},
        "end": {"type": "integer", "minimum": 1}
      }
    },
    "annotation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "guideline_version", "adjudication_status", "truth_basis"],
      "properties": {
        "method": {"const": "agent_assisted_manual_curation"},
        "guideline_version": {"$ref": "#/$defs/semver"},
        "adjudication_status": {"const": "accepted_for_course_review"},
        "truth_basis": {"const": "synthetic_corpus_exact"}
      }
    },
    "filter_expr": {
      "oneOf": [
        {"type": "object", "maxProperties": 0},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["and"],
          "properties": {"and": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/filter_expr"}}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["or"],
          "properties": {"or": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/filter_expr"}}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["not"],
          "properties": {"not": {"$ref": "#/$defs/filter_expr"}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["field", "operator", "value"],
          "properties": {
            "field": {"type": "string", "minLength": 1},
            "operator": {"enum": ["eq", "in", "gte", "lte"]},
            "value": {}
          }
        }
      ]
    },
    "query": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "locale", "filters"],
      "properties": {
        "text": {"type": "string", "minLength": 1},
        "locale": {"const": "zh-CN"},
        "filters": {"$ref": "#/$defs/filter_expr"}
      }
    },
    "source_document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "source_document_id", "source_version_id", "source_state_id", "state_effective_at", "tenant_id", "connector_id", "external_source_id", "source_uri", "display_name", "media_type", "byte_size", "content_sha256", "blob_uri", "source_metadata", "lifecycle_state"],
      "properties": {
        "schema_version": {"const": "1.0.0"},
        "source_document_id": {"type": "string", "pattern": "^src_[0-9a-f-]{36}$"},
        "source_version_id": {"type": "string", "pattern": "^sv_[0-9a-f]{32}$"},
        "source_state_id": {"type": "string", "format": "uuid"},
        "state_effective_at": {"type": "string", "format": "date-time"},
        "tenant_id": {"type": "string", "minLength": 1},
        "connector_id": {"type": "string", "minLength": 1},
        "external_source_id": {"type": "string", "pattern": "^corpus/documents/.+\\.md$"},
        "source_uri": {"type": "string", "pattern": "^repo://"},
        "display_name": {"type": "string", "minLength": 1},
        "media_type": {"const": "text/markdown"},
        "byte_size": {"type": "integer", "minimum": 1},
        "content_sha256": {"$ref": "#/$defs/sha256"},
        "blob_uri": {"type": "string", "pattern": "^dataset://"},
        "source_metadata": {"type": "object"},
        "lifecycle_state": {"const": "active"}
      }
    },
    "chunk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "chunk_id", "parsed_document_id", "source_document_id", "source_version_id", "chunk_profile", "ordinal", "text", "text_sha256", "document_char_span", "token_count", "section_path", "page_refs"],
      "properties": {
        "schema_version": {"const": "1.0.0"},
        "chunk_id": {"type": "string", "pattern": "^chk_[0-9a-f]{32}$"},
        "parsed_document_id": {"type": "string", "pattern": "^pd_[0-9a-f]{32}$"},
        "source_document_id": {"type": "string", "pattern": "^src_[0-9a-f-]{36}$"},
        "source_version_id": {"type": "string", "pattern": "^sv_[0-9a-f]{32}$"},
        "chunk_profile": {"$ref": "#/$defs/profile_ref"},
        "ordinal": {"type": "integer", "minimum": 0},
        "text": {"type": "string", "minLength": 1},
        "text_sha256": {"$ref": "#/$defs/sha256"},
        "document_char_span": {"$ref": "#/$defs/span"},
        "token_count": {"type": "integer", "minimum": 1, "maximum": 4096},
        "section_path": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 1}},
        "page_refs": {"type": "array", "items": {"type": "integer", "minimum": 1}}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authoring_method", "truth_basis", "source_chunk_keys", "source_document_ids", "review_rule_ids", "review_status"],
      "properties": {
        "authoring_method": {"const": "agent_assisted_manual_curation"},
        "truth_basis": {"const": "synthetic_corpus_exact"},
        "source_chunk_keys": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "source_document_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "review_rule_ids": {"type": "array", "minItems": 4, "uniqueItems": true, "items": {"type": "string"}},
        "review_status": {"const": "accepted_for_course_review"}
      }
    },
    "eval_case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "eval_case_id", "dataset_id", "dataset_version", "case_key", "split", "query", "category", "difficulty", "primary_diagnostic_stage", "tags", "provenance"],
      "properties": {
        "schema_version": {"const": "1.0.0"},
        "eval_case_id": {"type": "string", "pattern": "^case_[0-9a-f]{32}$"},
        "dataset_id": {"const": "rag_course_cooking"},
        "dataset_version": {"$ref": "#/$defs/semver"},
        "case_key": {"type": "string", "pattern": "^[a-z]+-[0-9]{3}$"},
        "split": {"enum": ["train", "dev", "test"]},
        "query": {"$ref": "#/$defs/query"},
        "category": {"enum": ["fact_qa", "multi_hop", "metadata_filter", "no_answer", "temporal_conflict", "ambiguous_query", "prompt_injection"]},
        "difficulty": {"enum": ["easy", "medium", "hard"]},
        "primary_diagnostic_stage": {"enum": ["retrieval", "context", "generation"]},
        "tags": {"type": "array", "minItems": 3, "uniqueItems": true, "items": {"type": "string"}},
        "provenance": {"$ref": "#/$defs/provenance"}
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim_key", "text"],
      "properties": {
        "claim_key": {"type": "string", "pattern": "^c[0-9]+$"},
        "text": {"type": "string", "minLength": 1}
      }
    },
    "reference_citation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim_key", "source_document_id", "source_version_id", "chunk_id", "chunk_char_span", "quote_sha256"],
      "properties": {
        "claim_key": {"type": "string", "pattern": "^c[0-9]+$"},
        "source_document_id": {"type": "string"},
        "source_version_id": {"type": "string"},
        "chunk_id": {"type": "string"},
        "chunk_char_span": {"$ref": "#/$defs/span"},
        "quote_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "ground_truth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "eval_case_id", "dataset_id", "dataset_version", "reference_answer", "required_claims", "unacceptable_claims", "allow_abstain", "expected_response_mode", "reference_citations", "annotation"],
      "properties": {
        "schema_version": {"const": "1.0.0"},
        "eval_case_id": {"type": "string", "pattern": "^case_[0-9a-f]{32}$"},
        "dataset_id": {"const": "rag_course_cooking"},
        "dataset_version": {"$ref": "#/$defs/semver"},
        "reference_answer": {"type": "string", "minLength": 1},
        "required_claims": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/claim"}},
        "unacceptable_claims": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "allow_abstain": {"type": "boolean"},
        "expected_response_mode": {"enum": ["answer", "abstain", "clarify"]},
        "reference_citations": {"type": "array", "items": {"$ref": "#/$defs/reference_citation"}},
        "annotation": {"$ref": "#/$defs/annotation"}
      }
    },
    "retrieval_label": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "eval_case_id", "dataset_id", "dataset_version", "source_document_id", "source_version_id", "chunk_id", "relevance_grade", "supports_claim_keys", "label_role", "annotation"],
      "properties": {
        "schema_version": {"const": "1.0.0"},
        "eval_case_id": {"type": "string"},
        "dataset_id": {"const": "rag_course_cooking"},
        "dataset_version": {"$ref": "#/$defs/semver"},
        "source_document_id": {"type": "string"},
        "source_version_id": {"type": "string"},
        "chunk_id": {"type": "string"},
        "relevance_grade": {"type": "integer", "minimum": 0, "maximum": 3},
        "supports_claim_keys": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "label_role": {"type": "string", "minLength": 1},
        "annotation": {"$ref": "#/$defs/annotation"}
      }
    },
    "file_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "record_type", "bytes", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "record_type": {"type": "string", "minLength": 1},
        "bytes": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "records": {"type": "integer", "minimum": 1}
      }
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "dataset_id", "dataset_version", "corpus_version", "contract_major", "status", "language", "license", "files", "compatible_profiles", "schema_contract", "metric_contract", "statistics", "provenance"],
      "properties": {
        "schema_version": {"const": "1.0.0"},
        "dataset_id": {"const": "rag_course_cooking"},
        "dataset_version": {"$ref": "#/$defs/semver"},
        "corpus_version": {"const": "corpus-1.0.0"},
        "contract_major": {"const": 1},
        "status": {"const": "release_candidate"},
        "language": {"const": "zh-CN"},
        "license": {"const": "CC-BY-4.0"},
        "files": {"type": "array", "minItems": 7, "uniqueItems": true, "items": {"$ref": "#/$defs/file_entry"}},
        "compatible_profiles": {"type": "object", "required": ["parser_profiles", "chunk_profiles", "required_source_version_ids_checksum"]},
        "schema_contract": {"type": "string"},
        "metric_contract": {"type": "string"},
        "statistics": {"type": "object", "required": ["cases", "sources", "chunks", "retrieval_labels", "by_category", "by_difficulty", "by_split", "by_primary_diagnostic_stage", "by_expected_response_mode"]},
        "provenance": {"type": "object", "required": ["corpus_kind", "authoring_method", "truth_basis", "automatic_llm_truth_imported"]}
      }
    }
  }
}
